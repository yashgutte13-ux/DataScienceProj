# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Pytest
.pytest_cache/
.coverage
htmlcov/

# Virtual environment
.venv/
env/
venv/
ENV/

# IDE files
.vscode/
.idea/

# Large generated data files
data/raw/*.csv
data/processed/*.csv
data/warehouse/powerbi_export/*.csv
data/warehouse/*.db

# Track quality reports
!data/processed/quality_report_before.json
!data/processed/quality_report_after.json

# Keep directory structures
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/warehouse/.gitkeep
!data/warehouse/powerbi_export/.gitkeep

# Large OS files
Thumbs.db
Desktop.ini
.DS_Store
